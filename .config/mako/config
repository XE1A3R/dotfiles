# ~/.config/mako/config
# Catppuccin Mocha, единый стиль с waybar

font=JetBrains Mono Nerd Font 12

# геометрия «под модуль waybar»
width=400
height=150
margin=10
padding=12
border-size=2
border-radius=4

# плашка как чип waybar: surface0 + mauve
background-color=#313244
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #cba6f7

anchor=top-right
layer=overlay
output=DP-5          # раскомментируй, если хочешь уведомления только на внешнем мониторе

sort=-time
max-visible=7
default-timeout=8000
ignore-timeout=0

# группировка: app+summary. body убрал — иначе спам не схлопывается
group-by=app-name,summary

# иконки (нужен papirus-icon-theme)
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/usr/share/icons/hicolor
max-icon-size=32

# normal: заголовок mauve + кто прислал — серым
format=<span foreground="#cba6f7" weight="bold">◆ %s</span> <span foreground="#6c7086" size="smaller">[%a]</span>\n%b

[urgency=low]
background-color=#181825
border-color=#45475a
text-color=#a6adc8
default-timeout=4000
format=<span foreground="#7f849c">· %s</span> <span foreground="#585b70" size="smaller">[%a]</span>\n%b

[urgency=critical]
background-color=#45171a
border-color=#f38ba8
default-timeout=0
format=<span foreground="#f38ba8" weight="bold">⚠ %s</span> <span foreground="#6c7086" size="smaller">[%a]</span>\n<span weight="bold">%b</span>
