[Default]
# Куда сохраняем скриншоты по умолчанию (поддерживает переменные окружения)
save_dir=$HOME/Pictures/Screenshots

# Формат имени файла. %Y%m%d-%H%M%S даст нам что-то вроде swappy-20261113-153000.png
# Это спасает от перезаписи файлов и позволяет легко сортировать их по дате (хотя бы в bash-скриптах)
save_filename_format=swappy-%Y%m%d-%H%M%S.png

# UI-твики. Для тайловых WM (Hyprland) часто лучше скрыть лишнее, чтобы не жрало место
show_panel=true
show_decorations=true

# Дефолтные параметры рисования
line_size=4
text_size=16
text_font=JetBrains Mono 14
paint_mode=arrow

# Автоматически закрывать программу после сохранения (Ctrl+S) или копирования (Ctrl+C)
# Это киллер-фича для автоматизации: сделал скрин, ткнул стрелочку, нажал Ctrl+S — и ты уже в терминале.
early_exit=true

# Не сохранять полупрозрачный фон при экспорте (важно, если делаешь скриншоты окон с тенями)
transparent=false
transparency=50
